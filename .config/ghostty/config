# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.

# A theme to use. This can be a built-in theme name, a custom theme
# name, or an absolute path to a custom theme file.
theme = flexoki-dark

# If "MonoLisa Variable" font is installed:
config-file = conf.d/font-monolisa

# Alternatively, comment the above, install VictorMono and uncomment below:
# config-file = conf.d/font-victormono

# Keybindings
config-file = conf.d/keybinds

# If ligatures are enabled (questionable choice), then at least break then under
# the cursor. Test: ({| X -> X => X !== X |})
font-shaping-break = cursor

# Whether to start the window in a maximized state. This setting applies
# to new windows and does not apply to tabs, splits, etc.
# However, this setting will apply to all new windows, not just the first one.
maximize = false

# Disable window decorations (titlebar, border, etc.).
window-decoration = none

# Don't save window state (always start maximized)
window-save-state = never

# Force single-instance mode. Default is detect, but I'm trying to have fast
# cold-starts by utilizing eager start of the terminal process (mimicking
# urxvt's server/client model) at start.
#
# NOTE: Despite all of my efforts it still starts separate process group.
#       Thus, I'm actually ditching any further attempt of using Ghostty.
#       Cold start of 1-1.5s is annoying, especially that kitty starts in
#       under 100ms even without single instance. But keeping the config
#       for now until I get disappointed to the same level as with FiSH.
gtk-single-instance = true

# Disable the ability to move the cursor at prompts by clicking on a
# location in the prompt text.
cursor-click-to-move = false
