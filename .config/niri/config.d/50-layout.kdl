layout {
  center-focused-column "never" // Don’t auto-center focused column
  always-center-single-column   // But auto-center sole column

  background-color "transparent" // <- needed for noctalia-shell to set wallpaper

  preset-column-widths {
    proportion 0.3
    proportion 0.5
    proportion 0.7
  }

  gaps 4

  struts {}

  // ╭───────────────────────────────────────────────────────────────────────╌┄┈
  // │ https://github.com/niri-wm/niri/wiki/Configuration:-Layout#focus-ring-and-border
  // ╰───────────────────────────────────────────────────────────────────────╌┄┈

  focus-ring { off; }

  border {
    on

    width 2

    active-gradient from="#3aa99fdd" to="#205ea6dd" angle=35 in="oklch shorter hue" relative-to="workspace-view"
    urgent-gradient from="#af3029ff" to="#af3029dd" angle=35 in="oklch shorter hue" relative-to="workspace-view"

    inactive-color "#403e3ccc"
  }

  // ╭───────────────────────────────────────────────────────────────────────╌┄┈
  // │ https://github.com/niri-wm/niri/wiki/Configuration:-Layout#shadow
  // │
  // │ Keep shadows off by default, but configure their defaul styling.
  // │
  // │ > Shadows default to off because they are a fairly performance-intensive
  // │ > shader, and because many clientside-decorated windows already
  // │ > draw their own shadows.
  // │ > -- https://github.com/niri-wm/niri/wiki/Development:-Design-Principles
  // ╰───────────────────────────────────────────────────────────────────────╌┄┈
  shadow {
    off

    color          "#100f0fee"
    inactive-color "#100f0f99"

    spread   3
    softness 21
  }

  // ╭───────────────────────────────────────────────────────────────────────╌┄┈
  // │ https://github.com/niri-wm/niri/wiki/Configuration:-Layout#tab-indicator
  // ╰───────────────────────────────────────────────────────────────────────╌┄┈

  tab-indicator {
    hide-when-single-tab
    place-within-column

    corner-radius 10
    width 6

    gaps-between-tabs 8

    position "left"

    length total-proportion=1.0

    active-gradient   from="#879A39" to="#3D4C07" angle=135 in="oklch shorter hue" relative-to="workspace-view"
    inactive-gradient from="#4385BE" to="#163B66" angle=135 in="oklch shorter hue" relative-to="workspace-view"
    urgent-gradient   from="#D14D41" to="#6C201C" angle=135 in="oklch shorter hue" relative-to="workspace-view"
  }

  // ╭───────────────────────────────────────────────────────────────────────╌┄┈
  // │ https://github.com/niri-wm/niri/wiki/Configuration:-Layout#insert-hint
  // ╰───────────────────────────────────────────────────────────────────────╌┄┈

  insert-hint {
    gradient from="#879a3999" to="#66800b99" angle=45 in="oklch"
  }
}
