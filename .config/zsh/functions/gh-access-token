# vim: ft=zsh

local profile="${2:-default}"
local attributes=("service" "github" "scope" "${profile}")

case "${1:-}" in
  update)
    print "Visit <https://github.com/settings/tokens> and create/update token"

    "${BROWSER:-xdg-open}" "https://github.com/settings/tokens"

    print "Please create new token and paste it here..."
    secret-tool store --label="Github Access Token (${profile})" "${attributes[@]}"

    gh-access-token setup
    ;;

  setup)
    typeset -xg GITHUB_TOKEN="$(secret-tool lookup "${attributes[@]}")"

    if [[ "default" == "${profile}" ]]; then
      typeset -gx BUNDLE_RUBYGEMS__PKG__GITHUB__COM="x-api-token:${GITHUB_TOKEN}"
    fi
    ;;

  show)
    secret-tool lookup "${attributes[@]}"
    ;;

  *)
    print -u2 "USAGE: gh-access-token {update|setup|show} [profile]"
    return 1
    ;;
esac
