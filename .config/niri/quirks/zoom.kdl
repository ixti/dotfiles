// ╭─────────────────────────────────────────────────────────────────────────╌┄┈
// │ Zoom Workspace
// ╰─────────────────────────────────────────────────────────────────────────╌┄┈

window-rule {
  // title=annotate_toolbar              -- circle with pencil during screensharing
  // title=as_toolbar                    -- screensharing toolbar that blocks 10% of a screen
  // title=zoom_linux_float_video_window -- video participants pane
  match app-id="(?i)^Zoom$" title="^(annotate_toolbar|as_toolbar|zoom_linux_float_video_window)$"

  open-floating true
  opacity       0.25 // Make those pesty useless floats semi-transparent

  // Disable decorations, because, yeah, Zoom devs are banned on Google to RTFM
  background-effect { blur false; xray false; }
  focus-ring        { off; }
  shadow            { off; }

  // Because Zoom devs also live in a bubble of unawareness of XDG decorations
  draw-border-with-background false
}

// TODO: Cleanup

window-rule {
    match app-id="(?i)^Zoom$" title="(?i)^(Leave meeting panel|cpt_frame_window|cpt_host_pn_window)$"

    // Forces these specific windows to float on top instead of tiling
    open-floating true

    background-effect {
      blur false
      xray false
    }

    focus-ring { off; }
    shadow { off; }

    draw-border-with-background false
}
