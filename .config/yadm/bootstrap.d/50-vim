#!/usr/bin/env bash

set -eEuo pipefail

if command -v vim >/dev/null 2>&1; then
  echo "╭────────────────────────────────────────────────────────────────────────────╌┄┈"
  echo "│ Bootstrapping Vim..."
  echo "╰────────────────────────────────────────────────────────────────────────────╌┄┈"

  vim '+PlugInstall' '+PlugClean!' '+qall'
fi
