# vim: ft=zsh

if (( !${+commands[secret-tool]} )); then
  print -u2 "*** secret-tool command not found ***"
  return 1
fi

local action="${1:-}"
local pat_name="${2:-}"
local attributes=("github.com" "${pat_name}")

if [[ -n "${pat_name}" ]]; then
  case "${action}" in
    update)
      print "Visit <https://github.com/settings/tokens> and create/update token."
      print "Please create new token and paste it here..."
      secret-tool store --label="GitHub PAT (${pat_name})" "${attributes[@]}"

      return 0
      ;;

    setup)
      typeset -xg GITHUB_TOKEN="$(secret-tool lookup "${attributes[@]}")"

      return 0
      ;;

    show)
      secret-tool lookup "${attributes[@]}"

      return 0
      ;;
  esac
fi

print -u2 "USAGE: gh-access-token {update|setup|show} IDENTIFIER"
return 1
