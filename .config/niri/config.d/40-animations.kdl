animations {
  // Global multiplier. Lower is faster (e.g., 0.8 is 20% faster than default).
  slowdown 1.0

  // ╭─── Infinite Strip & Workspace Movements ──────────────────────────────╌┄┈
  // ╰───────────────────────────────────────────────────────────────────────╌┄┈

  horizontal-view-movement {
    spring damping-ratio=1.0 stiffness=1150 epsilon=0.0001
  }

  window-movement {
    spring damping-ratio=1.0 stiffness=1150 epsilon=0.0001
  }

  workspace-switch {
    spring damping-ratio=1.0 stiffness=1250 epsilon=0.0001
  }

  window-resize {
    spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
  }

  // ╭─── Discrete UI Events ────────────────────────────────────────────────╌┄┈
  // ╰───────────────────────────────────────────────────────────────────────╌┄┈

  window-open {
    duration-ms 130
    curve "ease-out-expo"
  }

  window-close {
    duration-ms 90
    curve "ease-out-quad"
  }

  config-notification-open-close {
    spring damping-ratio=0.8 stiffness=1200 epsilon=0.001
  }

  exit-confirmation-open-close {
    duration-ms 140
    curve "ease-out-cubic"
  }

  // ╭─── TODO ──────────────────────────────────────────────────────────────╌┄┈
  // ╰───────────────────────────────────────────────────────────────────────╌┄┈

  screenshot-ui-open {
    duration-ms 200
    curve "ease-out-quad"
  }

  overview-open-close {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
  }

  recent-windows-close {
    spring damping-ratio=1.0 stiffness=800 epsilon=0.001
  }
}
