# vim: ft=zsh

_fnox() {
  set -e
  fnox --config "${XDG_CONFIG_HOME}/fnox/config.toml" "$@"
}

_set_token() {
  _fnox set GITHUB_TOKEN "$1"
}

_get_token() {
  _fnox get GITHUB_TOKEN
}

case "${1:-}" in
  update)
    print "Visit <https://github.com/settings/tokens> and create/update token"

    "${BROWSER:-xdg-open}" "https://github.com/settings/tokens"

    print "Please create new token and paste it here..."

    read -p "GH Token: " GITHUB_TOKEN

    if [[ -z "${GITHUB_TOKEN}" ]]; then
      print -u2 "You've provided no token, interrupting..."
      return 1
    fi

    _set_token "${GITHUB_TOKEN}"

    return 0
    ;;

  setup)
    typeset -gx BUNDLE_RUBYGEMS__PKG__GITHUB__COM="x-api-token:$(_get_token)"

    return 0
    ;;

  show)
    _get_token

    return 0
    ;;

  *)
    print -u2 "USAGE: gh-access-token {update|setup|show}"

    return 1
    ;;
esac
