prefer-no-csd

screenshot-path null

environment {
  ELECTRON_OZONE_PLATFORM_HINT        "wayland"
  QT_QPA_PLATFORM                     "wayland"
  QT_QPA_PLATFORMTHEME                "gtk3"
  QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
  XDG_CURRENT_DESKTOP                 "niri"
  XDG_SESSION_TYPE                    "wayland"
}

// TODO: Refactor
include "./cfg/overview.kdl"
include "./cfg/animation.kdl"
include "./cfg/autostart.kdl"
include "./cfg/keybinds.kdl"
include "./cfg/input.kdl"
include "./cfg/display.kdl"
include "./cfg/misc.kdl"

// Finalized variant
include "./config.d/50-layout.kdl"
include "./config.d/50-recent-windows.kdl"
include "./config.d/80-layer-rules.kdl"
include "./config.d/80-window-rules.kdl"
include "./config.d/90-binds.kdl"
