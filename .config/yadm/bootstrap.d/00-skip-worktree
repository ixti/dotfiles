#!/usr/bin/env bash

set -eEuo pipefail

# Add files that should not track changes, e.g. ".config/niri/noctalia.kdl"
SKIP_WORKTREE_FILES=()

# Skip tracking changes to auto-generated files that need to be present with
# some defaults, beforehand, e.g. `noctalia.kdl` include in `niri`.
if [[ ${#SKIP_WORKTREE_FILES[@]} -ne 0 ]]; then
  home="$(yadm rev-parse --show-toplevel)"

  echo "╭────────────────────────────────────────────────────────────────────────────╌┄┈"
  echo "│ Masking some config files to ignore local modifications..."
  echo "╰────────────────────────────────────────────────────────────────────────────╌┄┈"

  for f in "${SKIP_WORKTREE_FILES[@]}"; do
    yadm update-index --skip-worktree "${home}/${f}"
  done
fi
