// ╭─── Window Rules ────────────────────────────────────────────────────────╌┄┈
// │ https://github.com/niri-wm/niri/wiki/Configuration:-Window-Rules
// ╰─────────────────────────────────────────────────────────────────────────╌┄┈

window-rule {
  geometry-corner-radius 5

  // Clips window contents to the rounded corner boundaries.
  clip-to-geometry true
}

window-rule {
  match is-floating=true

  shadow { on; }
}


include "./window-rules/bitwarden.kdl"
include "./window-rules/firefox.kdl"
include "./window-rules/slack.kdl"
include "./window-rules/steam.kdl"
include "./window-rules/telegram.kdl"
include "./window-rules/zoom.kdl"
