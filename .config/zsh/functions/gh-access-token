# vim: ft=zsh

local attr="github"
local name="token"

_show_token() {
  secret-tool lookup "${attr}" "${name}"
}

case "${1:-}" in
  update)
    print "Visit <https://github.com/settings/tokens> and create/update token"

    "${BROWSER:-xdg-open}" "https://github.com/settings/tokens"

    print "Please create new token and paste it here..."

    secret-tool store --label="Github Private Registries Access Token" "${attr}" "${name}"

    gh-access-token setup

    return 0
    ;;

  setup)
    typeset -gx BUNDLE_RUBYGEMS__PKG__GITHUB__COM="x-api-token:$(_show_token)"

    return 0
    ;;

  show)
    _show_token

    return 0
    ;;

  *)
    print -u2 "USAGE: gh-access-token {update|setup|show}"

    return 1
    ;;
esac
